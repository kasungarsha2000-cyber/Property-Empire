{
  "name": "property-empire-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "node scripts/dev-lan.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/cache-manifest.mjs && tsup apps/server/src/index.ts --format esm --out-dir apps/server/dist --external ws",
    "start:lan": "node apps/server/dist/index.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build",
    "test:e2e:full": "npm run build && playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "node scripts/android-build.mjs debug"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.2",
    "@fontsource/fredoka": "^5.2.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/nunito": "^5.2.0",
    "three": "^0.180.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
